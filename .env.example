# Kopjojeni si `.env` dhe plotësoni dy sekretet. Shërbimi nuk nis pa to.
#
# Sekreti i JWT-së (të paktën 32 shenja):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Çelësi i kodimit të skedarëve (Fernet):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Çelësi i kodimit nuk ndërrohet pa rikoduar skedarët: me çelës tjetër,
# dokumentet e ruajtura nuk lexohen më.

ANALYTE_JWT_SECRET=
ANALYTE_STORAGE_KEY=

ANALYTE_DATABASE_URL=postgresql+psycopg://analyte:analyte@localhost:5433/analyte
ANALYTE_REDIS_URL=redis://localhost:6379/0
ANALYTE_STORAGE_DIR=storage
ANALYTE_JOB_RUNNER=arq
ANALYTE_OCR=true

# Tesseract, nëse nuk është në PATH ose në vendin e zakonshëm:
# ANALYTE_TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe
# ANALYTE_TESSDATA=C:\Users\<ju>\AppData\Local\tesseract\tessdata

# Posta (ADR 0016). Llogaria aktivizohet me një lidhje të dërguar me email, prandaj shërbimi nuk nis me
# `smtp` pa host. Në zhvillim përdoret kutia e provës e Mailtrap (Email Testing > Inboxes > SMTP Settings):
# kopjoni host, port, përdoruesin dhe fjalëkalimin e saj këtu. Kredencialet nuk shkruhen kurrë në kod,
# në ADR apo në bisedë; kutia e provës nuk dërgon te adresa të vërteta.
# ANALYTE_MAIL_BACKEND=smtp
# ANALYTE_SMTP_HOST=sandbox.smtp.mailtrap.io
# ANALYTE_SMTP_PORT=2525
# ANALYTE_SMTP_SECURITY=starttls
# ANALYTE_SMTP_USERNAME=
# ANALYTE_SMTP_PASSWORD=
# ANALYTE_MAIL_FROM=ANALYTE <noreply@analyte.local>
# Baza e lidhjeve në email: {ANALYTE_FRONTEND_URL}/confirm?token=…
# ANALYTE_FRONTEND_URL=http://localhost:3000
#
# Zhvillim pa SMTP: mesazhi shkruhet te log-u i shërbimit (me adresën dhe lidhjen; mos e përdor në prodhim).
# ANALYTE_MAIL_BACKEND=console
#
# Sa vlen lidhja e konfirmimit, dhe kufijtë e regjistrimeve/ridërgimeve në dritaren e tyre.
# ANALYTE_CONFIRM_TOKEN_HOURS=24
# ANALYTE_REGISTER_WINDOW_MINUTES=60
# ANALYTE_REGISTER_MAX_PER_IP=10
# ANALYTE_REGISTER_MAX_PER_EMAIL=3
#
# Adresat IPv6 numërohen sipas këtij prefiksi (ADR 0016).
# ANALYTE_IPV6_PREFIX_BITS=64

# Rivendosja e fjalëkalimit, hapi i dytë (TOTP) dhe rindërgimi i mesazheve (ADR 0018). Parazgjedhjet janë të arsyeshme.
# Lidhja e rivendosjes vlen kaq minuta (një herë), dhe kaq dorëzime të formës së saj lejohen nga një IP në
# dritaren e regjistrimit (të suksesshme ose jo).
# ANALYTE_RESET_TOKEN_MINUTES=60
# ANALYTE_RESET_SUBMIT_MAX_PER_IP=20
#
# Sfida që del pas fjalëkalimit të saktë kur llogaria ka hap të dytë, dhe kodet e gabuara të lejuara në
# ANALYTE_LOGIN_WINDOW_MINUTES: për çiftin (përdorues, IP), për një IP, dhe për një përdorues nga çdo IP.
# Sekreti TOTP kodohet me ANALYTE_STORAGE_KEY, e njëjta me skedarët: ndërrimi i çelësit kërkon rikodim të të dyjave.
# ANALYTE_MFA_CHALLENGE_MINUTES=5
# ANALYTE_MFA_MAX_FAILURES_PAIR=5
# ANALYTE_MFA_MAX_FAILURES_IP=20
# ANALYTE_MFA_MAX_FAILURES_USER=10
# ANALYTE_MFA_RECOVERY_CODES=8
# ANALYTE_MFA_ISSUER=ANALYTE
#
# Dërgimi i email-eve: sa prova (me pritje që dyfishohet) para se mesazhi të lihet i padërguar; pastaj punëtori arq
# (çdo 10 minuta) rilëshon një lidhje të re për mesazhet që prisnin MAIL_RESEND_AFTER_MINUTES, jo më shumë se
# MAIL_AUTO_REISSUE_PER_DAY për përdorues në 24 orë. Regjistrimet e dërgimit (pa adresa) mbahen kaq ditë.
# ANALYTE_MAIL_SEND_ATTEMPTS=3
# ANALYTE_MAIL_RETRY_BACKOFF_SECONDS=2
# ANALYTE_MAIL_RESEND_AFTER_MINUTES=10
# ANALYTE_MAIL_AUTO_REISSUE_PER_DAY=2
# ANALYTE_MAIL_DELIVERY_RETENTION_DAYS=30

# Kufizimi i hyrjeve dhe seancat (ADR 0014). Parazgjedhjet janë të arsyeshme;
# ndryshojini vetëm me arsye.
# ANALYTE_LOGIN_WINDOW_MINUTES=15
# ANALYTE_LOGIN_MAX_FAILURES_PAIR=5
# ANALYTE_LOGIN_MAX_FAILURES_IP=20
# ANALYTE_LOGIN_MAX_FAILURES_EMAIL=20
# ANALYTE_REFRESH_REUSE_GRACE_SECONDS=10
#
# Pas një proxy (nginx, një balancues), sa ndërmjetës të besuar qëndrojnë para
# shërbimit. Me 0, IP-ja është adresa e lidhjes. Mos e vendos mbi 0 pa proxy:
# koka X-Forwarded-For mund ta shkruajë kushdo dhe kufizimi do të anashkalohej.
# ANALYTE_TRUSTED_PROXY_HOPS=0


# Modeli gjuhësor: për eksperimentet (harness-i) dhe, vetëm kur zgjidhet shprehimisht, për aplikacionin e uebit.
# Bosh = pa model: shpjegimi del nga shablloni determinist. Çelësi nuk shkruhet
# kurrë në kod, në ADR apo në bisedë.
#
# Aplikacioni gjeneron me shabllon (parazgjedhja) edhe kur ofruesi është këtu; harness-i e përdor gjithsesi. Që aplikacioni
# të përdorë modelin: ANALYTE_SERVICE_GENERATOR=model (ADR 0017). Atëherë konteksti i dokumenteve të ngarkuara me pëlqim (vlera,
# intervale, statuse, citime të mjekut; jo emri, mosha, gjinia apo skedari) i dërgohet ofruesit, pa cache në disk, dhe
# teksti mban njoftimin se e shkroi një model. Kjo është vendim për të dhëna shëndetësore (docs/ethics): mos e ndiz mbi
# dokumente reale pa e vendosur.
# ANALYTE_SERVICE_GENERATOR=template
#
# Me `model`, çdo ngarkim ka një kuti pëlqimi (e pashënuar si parazgjedhje; ADR 0019). Pa pëlqim, dokumenti del me shabllon
# dhe asnjë kërkesë nuk i dërgohet ofruesit. Edhe me pëlqim, citimet e mjekut kalojnë një portë çidentifikimit që dështon e
# mbyllur: nëse shënon emër, datë, telefon, email, numër të gjatë, identifikues etj., dokumenti nuk dërgohet. Kushtet e
# ofruesit, baza ligjore dhe miratimi etik janë vendime të autorit, jo të këtij konfigurimi.
#
# Ofruesi: gemini | mistral | groq | cerebras | openrouter | openai_compatible
# (ky i fundit kërkon edhe ANALYTE_LLM_BASE_URL). Modeli duhet të jetë emri i saktë
# me version, jo një pseudonim `-latest` që ndryshon pa dije.
# ANALYTE_LLM_PROVIDER=mistral
# ANALYTE_LLM_MODEL=
# ANALYTE_LLM_API_KEY=
#
# Gjykatësi i E12. Bosh = i njëjti ofrues, çelës dhe model me gjeneruesin (kufizim që
# duhet raportuar: modeli gjykon daljen e vet). Mund të jetë ofrues tjetër:
# ANALYTE_LLM_JUDGE_PROVIDER=cerebras
# ANALYTE_LLM_JUDGE_MODEL=
# ANALYTE_LLM_JUDGE_API_KEY=
#
# Sa thirrje në minutë; vendosni kufirin e ofruesit ose më pak.
# ANALYTE_LLM_REQUESTS_PER_MINUTE=10

# Afati i ruajtjes së dokumenteve në ditë (ADR 0019). 0 = pa afat, dokumentet ruhen derisa pronari t'i fshijë (parazgjedhja).
# Me vlerë pozitive, punëtori (`make worker`) fshin çdo orë dokumentet më të vjetra se afati, me të njëjtën rrugë si fshirja
# nga pronari. Gjatësia e afatit është vendim i autorit; mos e ndrysho pa e vendosur.
# ANALYTE_DOCUMENT_RETENTION_DAYS=0
