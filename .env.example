# Kopjojeni si `.env` dhe plotësoni dy sekretet. Shërbimi nuk nis pa to.
#
# Sekreti i JWT-së (të paktën 32 shenja):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Çelësi i kodimit të skedarëve (Fernet):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Çelësi i kodimit nuk ndërrohet pa rikoduar skedarët: me çelës tjetër,
# dokumentet e ruajtura nuk lexohen më.

ANALYTE_JWT_SECRET=
ANALYTE_STORAGE_KEY=

ANALYTE_DATABASE_URL=postgresql+psycopg://analyte:analyte@localhost:5433/analyte
ANALYTE_REDIS_URL=redis://localhost:6379/0
ANALYTE_STORAGE_DIR=storage
ANALYTE_JOB_RUNNER=arq
ANALYTE_OCR=true

# Tesseract, nëse nuk është në PATH ose në vendin e zakonshëm:
# ANALYTE_TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe
# ANALYTE_TESSDATA=C:\Users\<ju>\AppData\Local\tesseract\tessdata

# Kufizimi i hyrjeve dhe seancat (ADR 0014). Parazgjedhjet janë të arsyeshme;
# ndryshojini vetëm me arsye.
# ANALYTE_LOGIN_WINDOW_MINUTES=15
# ANALYTE_LOGIN_MAX_FAILURES_PAIR=5
# ANALYTE_LOGIN_MAX_FAILURES_IP=20
# ANALYTE_LOGIN_MAX_FAILURES_EMAIL=20
# ANALYTE_REFRESH_REUSE_GRACE_SECONDS=10
#
# Pas një proxy (nginx, një balancues), sa ndërmjetës të besuar qëndrojnë para
# shërbimit. Me 0, IP-ja është adresa e lidhjes. Mos e vendos mbi 0 pa proxy:
# koka X-Forwarded-For mund ta shkruajë kushdo dhe kufizimi do të anashkalohej.
# ANALYTE_TRUSTED_PROXY_HOPS=0


# Modeli gjuhësor (vetëm për gjenerimin e shpjegimit dhe për eksperimentet).
# Bosh = pa model: shpjegimi del nga shablloni determinist. Çelësi nuk shkruhet
# kurrë në kod, në ADR apo në bisedë.
#
# Ofruesi: gemini | mistral | groq | cerebras | openrouter | openai_compatible
# (ky i fundit kërkon edhe ANALYTE_LLM_BASE_URL). Modeli duhet të jetë emri i saktë
# me version, jo një pseudonim `-latest` që ndryshon pa dije.
# ANALYTE_LLM_PROVIDER=mistral
# ANALYTE_LLM_MODEL=
# ANALYTE_LLM_API_KEY=
#
# Gjykatësi i E12. Bosh = i njëjti ofrues, çelës dhe model me gjeneruesin (kufizim që
# duhet raportuar: modeli gjykon daljen e vet). Mund të jetë ofrues tjetër:
# ANALYTE_LLM_JUDGE_PROVIDER=cerebras
# ANALYTE_LLM_JUDGE_MODEL=
# ANALYTE_LLM_JUDGE_API_KEY=
#
# Sa thirrje në minutë; vendosni kufirin e ofruesit ose më pak.
# ANALYTE_LLM_REQUESTS_PER_MINUTE=10
